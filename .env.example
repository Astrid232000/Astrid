# Copy this file to .env and fill in real values.
# Never put a real secret in THIS file (.env.example) — it's a template,
# even though .gitignore currently excludes .env* entirely.

# PostgreSQL connection string. Point this at a real Postgres instance
# (local install, Docker, or managed). `npx prisma dev --detach` (Prisma's
# throwaway local server) is an option but proved unreliable in dev here —
# see README.md.
DATABASE_URL="postgresql://user:password@localhost:5432/zawadie?schema=public"

# Auth.js (NextAuth) — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI API key — required for lead qualification (/analyze) and the
# sales assistant (/assist) to work. Without it those two endpoints return a
# clear 502 error; everything else in the app works normally.
OPENAI_API_KEY=""

# Optional: override the OpenAI model used for AI features.
# OPENAI_MODEL="gpt-4o"
